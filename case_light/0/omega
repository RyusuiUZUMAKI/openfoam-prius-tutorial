FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 22.4;

boundaryField
{
    inlet
    {
        type            empty;
    }

    outlet
    {
        type            empty;
    }

    y_max
    {
        type            omegaWallFunction;
        value           uniform 22.4;
    }

    y_min
    {
        type            omegaWallFunction;
        value           uniform 22.4;
    }

    z_max
    {
        type            omegaWallFunction;
        value           uniform 22.4;
    }

    z_min
    {
        type            omegaWallFunction;
        value           uniform 22.4;
    }

    cylinder
    {
        type            omegaWallFunction;
        value           uniform 22.4;
    }
}




